    "# ==============================================================================\n",
    "# Table 1: 基线特征描述统计与组间比较脚本 (隐藏左侧索引列版)\n",
    "# ==============================================================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "from sklearn.model_selection import train_test_split\n",
    "from IPython.display import display\n",
    "\n",
    "# 1. 全局配置与数据读取\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.width', 1000)\n",
    "\n",
    "file_path = \"Normed_x_y_in_T1_T2.csv\"\n",
    "df = pd.read_csv(file_path)\n",
    "\n",
    "# 2. 定义分析变量列名\n",
    "X_cols = ['T1_NPSS_x1_norm', 'T1_BSS_x2_norm', 'T1_PSPP_x3_norm', 'T1_SOQ_x4_norm']\n",
    "cov_col = 'T1_SAS_标准分_y1'\n",
    "y_col = 'T2_SAS_Anxiety_Binary'\n",
    "\n",
    "df_clean = df.dropna(subset=X_cols + [cov_col, y_col]).copy()\n",
    "df_clean[y_col] = df_clean[y_col].astype(int)\n",
    "\n",
    "# 3. 按 80:20 进行分层切分 (保持 random_state=42 与建模集一致)\n",
    "train_df, test_df = train_test_split(\n",
    "    df_clean, test_size=0.20, random_state=42, stratify=df_clean[y_col]\n",
    ")\n",
    "\n",
    "# 学术映射名称\n",
    "var_map = {\n",
    "    'T1_NPSS_x1_norm': 'T1 负面身体自我 (NPSS)',\n",
    "    'T1_BSS_x2_norm': 'T1 身体监控 (BSS)',\n",
    "    'T1_PSPP_x3_norm': 'T1 身体自尊 (PSPP)',\n",
    "    'T1_SOQ_x4_norm': 'T1 自我客体化 (SOQ)',\n",
    "    'T1_SAS_标准分_y1': 'T1 焦虑标准分 (SAS)',\n",
    "    'T2_SAS_Anxiety_Binary': 'T2 临床焦虑发作率 [N (%)]'\n",
    "}\n",
    "\n",
    "records = []\n",
    "\n",
    "# 4. 统计连续变量\n",
    "for var in X_cols + [cov_col]:\n",
    "    # 全样本统计\n",
    "    m_all, sd_all = df_clean[var].mean(), df_clean[var].std()\n",
    "    min_all, max_all = df_clean[var].min(), df_clean[var].max()\n",
    "    \n",
    "    # 训练集与测试集统计\n",
    "    m_tr, sd_tr = train_df[var].mean(), train_df[var].std()\n",
    "    m_te, sd_te = test_df[var].mean(), test_df[var].std()\n",
    "    \n",
    "    # T2 焦虑分组比较 (全样本视角)\n",
    "    g0 = df_clean[df_clean[y_col] == 0][var]\n",
    "    g1 = df_clean[df_clean[y_col] == 1][var]\n",
    "    \n",
    "    m_g0, sd_g0 = g0.mean(), g0.std()\n",
    "    m_g1, sd_g1 = g1.mean(), g1.std()\n",
    "    \n",
    "    # 独立样本 t 检验\n",
    "    t_stat, p_val = stats.ttest_ind(g1, g0)\n",
    "    \n",
    "    # P 值显著性标注\n",
    "    if p_val < 0.001:\n",
    "        p_str = f\"{p_val:.4f} ***\"\n",
    "    elif p_val < 0.01:\n",
    "        p_str = f\"{p_val:.4f} **\"\n",
    "    elif p_val < 0.05:\n",
    "        p_str = f\"{p_val:.4f} *\"\n",
    "    else:\n",
    "        p_str = f\"{p_val:.4f}\"\n",
    "        \n",
    "    records.append({\n",
    "        '变量名称 (Variables)': var_map[var],\n",
    "        '全样本 (N=589)': f\"{m_all:.4f} ± {sd_all:.4f}\",\n",
    "        '极值范围 (Min, Max)': f\"[{min_all:.4f}, {max_all:.4f}]\",\n",
    "        '训练集 (N=471)': f\"{m_tr:.4f} ± {sd_tr:.4f}\",\n",
    "        '测试集 (N=118)': f\"{m_te:.4f} ± {sd_te:.4f}\",\n",
    "        'T2 未发作组 (N=276)': f\"{m_g0:.4f} ± {sd_g0:.4f}\",\n",
    "        'T2 焦虑组 (N=313)': f\"{m_g1:.4f} ± {sd_g1:.4f}\",\n",
    "        't / χ² 检验值': f\"{t_stat:.4f}\",\n",
    "        'p 值 (组间差异)': p_str\n",
    "    })\n",
    "\n",
    "# 5. 统计分类变量 (T2 焦虑发作率)\n",
    "n_all_pos, pct_all = df_clean[y_col].sum(), (df_clean[y_col].mean() * 100)\n",
    "n_tr_pos, pct_tr = train_df[y_col].sum(), (train_df[y_col].mean() * 100)\n",
    "n_te_pos, pct_te = test_df[y_col].sum(), (test_df[y_col].mean() * 100)\n",
    "\n",
    "records.append({\n",
    "    '变量名称 (Variables)': var_map[y_col],\n",
    "    '全样本 (N=589)': f\"{n_all_pos} ({pct_all:.2f}%)\",\n",
    "    '极值范围 (Min, Max)': \"[0, 1]\",\n",
    "    '训练集 (N=471)': f\"{n_tr_pos} ({pct_tr:.2f}%)\",\n",
    "    '测试集 (N=118)': f\"{n_te_pos} ({pct_te:.2f}%)\",\n",
    "    'T2 未发作组 (N=276)': \"0 (0.00%)\",\n",
    "    'T2 焦虑组 (N=313)': f\"{n_all_pos} (100.00%)\",\n",
    "    't / χ² 检验值': \"—\",\n",
    "    'p 值 (组间差异)': \"—\"\n",
    "})\n",
    "\n",
    "df_table1 = pd.DataFrame(records)\n",
    "\n",
    "# 6. HTML 格式化展示 (加入 .hide(axis='index') 隐藏左侧索引列)\n",
    "styled_table1 = df_table1.style\\\n",
    "    .hide(axis='index')\\\n",
    "    .set_caption(\"<b>Table 1: Baseline Characteristics and Group Differences (APA 7th Standard)</b>\")\\\n",
    "    .set_table_styles([\n",
    "        {'selector': 'caption', 'props': [('color', '#1a365d'), ('font-size', '16px'), ('text-align', 'left'), ('padding-bottom', '10px')]},\n",
    "        {'selector': 'th', 'props': [('background-color', '#2b6cb0'), ('color', 'white'), ('font-weight', 'bold'), ('text-align', 'center'), ('padding', '10px 12px')]},\n",
    "        {'selector': 'td', 'props': [('text-align', 'center'), ('padding', '8px 12px')]},\n",
    "        {'selector': 'tr:nth-child(even)', 'props': [('background-color', '#f7fafc')]},\n",
    "        {'selector': 'tr:hover', 'props': [('background-color', '#edf2f7')]}\n",
    "    ])\n",
    "\n",
    "# 自动导出没有索引列的干净 CSV 文件\n",
    "df_table1.to_csv(\"Table1_Final_APA.csv\", index=False, encoding='utf_8_sig')\n",
    "\n",
    "print(\"=\"*85)\n",
    "print(\"📊 Table 1 生成成功（已隐藏最左侧数字索引列）！渲染效果如下：\")\n",
    "print(\"=\"*85 + \"\\n\")\n",
    "\n",
    "display(styled_table1)"
   ]
